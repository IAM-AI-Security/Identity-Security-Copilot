AWS_REGION=us-east-1
AWS_PROFILE=default
# Bedrock Mantle API key. This is a real secret: .env is gitignored for this reason, so keep the value there and never here.
BEDROCK_MANTLE_API_KEY=
RAG_TOP_K=7
RAG_SIMILARITY_THRESHOLD=0.35

# Bedrock Guardrails contextual grounding (Layer 4).
# The id and version are not secrets and are safe to commit as placeholders.
# The guardrail ARN is not: it embeds the AWS account id, so never put the ARN
# here or anywhere else in the repository. The code takes the id and version
# only. Both are required: if either is unset the grounding check refuses
# rather than being skipped, so an answer is never served unchecked.
BEDROCK_GUARDRAIL_ID=your-guardrail-id
BEDROCK_GUARDRAIL_VERSION=1
